{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "loans": {
        "ClusterId": "loans",
        "Order": 10,
        "Match": { "Path": "/api/loans/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "loans", "Version": "v1" }
      },
      "readers": {
        "ClusterId": "loans",
        "Order": 10,
        "Match": { "Path": "/api/readers/{**catch-all}" }
      },
      "books": {
        "ClusterId": "books",
        "Order": 10,
        "Match": { "Path": "/api/books/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "feedback",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Metadata": { "Team": "feedback", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "loans": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://loans-api" } }
      },
      "books": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://books-api" } }
      },
      "feedback": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://feedback-api" } }
      }
    }
  }
}
