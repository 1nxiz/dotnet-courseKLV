{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "loans": {
        "ClusterId": "loans",
        "Order": 10,
        "Match": {
          "Path": "/api/loans/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "loans",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "readers": {
        "ClusterId": "loans",
        "Order": 10,
        "Match": {
          "Path": "/api/readers/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "books": {
        "ClusterId": "books",
        "Order": 10,
        "Match": {
          "Path": "/api/books/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "reviews": {
        "ClusterId": "feedback",
        "Order": 10,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "Metadata": {
          "Team": "feedback",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "payments": {
        "ClusterId": "payments",
        "Order": 10,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "Metadata": {
          "Team": "payments",
          "Version": "v1"
        }
      },
      "auth": {
        "ClusterId": "auth",
        "Order": 5,
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Metadata": {
          "Team": "identity",
          "Version": "v1"
        }
      },
      "users": {
        "ClusterId": "auth",
        "Order": 5,
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "Metadata": {
          "Team": "identity",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "loans": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://loans-api"
          }
        }
      },
      "books": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://books-api"
          }
        }
      },
      "feedback": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://feedback-api"
          }
        }
      },
      "auth": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments-api": {
            "Address": "http://payments-api"
          }
        }
      }
    }
  },
  "Jwt": {
    "Issuer": "library-auth-service",
    "Audience": "library-platform",
    "SecretKey": "dev-only-library-platform-jwt-signing-key-change-me-0123456789"
  },
  "IdentityServer": {
    "IssuerUri": "https://identity.library.local"
  },
  "Keycloak": {
    "Realm": "library"
  }
}
