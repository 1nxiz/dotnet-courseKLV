{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?maxPoolSize=50&serverSelectionTimeoutMS=5000",
    "DatabaseName": "FeedbackDb"
  },
  "LuckyPenny": {
    "LicenseKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5103",
        "Protocols": "Http1"
      },
      "grpc": {
        "Url": "http://localhost:5113",
        "Protocols": "Http2"
      }
    }
  },
  "Caching": {
    "MemorySizeLimit": 5000
  },
  "Jwt": {
    "Issuer": "library-auth-service",
    "Audience": "library-platform",
    "SecretKey": "dev-only-library-platform-jwt-signing-key-change-me-0123456789"
  },
  "IdentityServer": {
    "IssuerUri": "https://identity.library.local"
  },
  "Keycloak": {
    "Realm": "library"
  }
}
