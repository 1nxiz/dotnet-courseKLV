{
  "ConnectionStrings": {
    "BooksDb": "Server=localhost,1433;Database=BooksDb;User Id=sa;Password=Library_Pass123;TrustServerCertificate=True;Encrypt=False"
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "RecreateIfNotMigrated": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/books-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
