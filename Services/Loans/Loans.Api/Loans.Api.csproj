<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Web/API: тонкі контролери, gRPC (Protos/, Grpc/), обробка помилок (ProblemDetails), Swagger, налаштування хосту. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>loans-api-3d9b1c52</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.67.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.2" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.67.0" />
  </ItemGroup>
  <!-- gRPC-контракт (Лаб. 06): серверна частина тут, клієнтська — у Platform.Aggregator -->
  <ItemGroup>
    <Protobuf Include="Protos\loans.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\Platform.EventBus\Platform.EventBus.csproj" />
    <ProjectReference Include="..\Loans.Bll\Loans.Bll.csproj" />
    <ProjectReference Include="..\Loans.Dal\Loans.Dal.csproj" />
  </ItemGroup>
  <!-- Скрипти Лаб. 01 підключено ПОСИЛАННЯМ (не копією): ними DatabaseInitializer розгортає LoansDb у Development/Aspire -->
  <ItemGroup>
    <Content Include="..\..\..\db\p1\schema.sql" Link="Database\schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\db\p1\procedures.sql" Link="Database\procedures.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\db\p1\seed.sql" Link="Database\seed.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Лаб. 08: SQL-міграції сервісу (SqlMigrator) -->
    <Content Include="..\Loans.Dal\Migrations\*.sql" Link="Migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
